# Public browser configuration only. Never put server credentials in VITE_*.
VITE_API_URL=/api
VITE_MAPBOX_TOKEN=
# Required: copy all four values from the Firebase project selected for this environment.
# There is no default project; missing or placeholder values stop initialization.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional matching project fields:
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_MEASUREMENT_ID=
