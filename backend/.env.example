# Development only. Keep the real .env private and ignored.
NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=humanaid_dev
DB_USER=humanaid_app
DB_PASSWORD=
DB_POOL_MAX=5
DB_SSL_MODE=disable
# Production: configure DB_SSL_MODE=verify-full (+ DB_SSL_CA if needed),
# or a reviewed INSTANCE_CONNECTION_NAME Cloud SQL socket binding.
# Production must supply all DB fields and explicit HTTPS CORS origins.
# ALLOW_REMOTE_DATABASE=true requires intentional nonproduction remote access.
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0
# Use a dedicated development Firebase project and Application Default Credentials.
FIREBASE_PROJECT_ID=
# No private key belongs in source. Never use an auth emulator in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Maintenance scripts require separate explicit operator approval/environment.
# ALLOW_DATABASE_MAINTENANCE=true
# ALLOW_ADMIN_BOOTSTRAP=true
